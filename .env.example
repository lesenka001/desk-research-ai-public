# Postgres connection string. On Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@localhost:5432/desk_research
# Internal Open WebUI endpoint; the API key is supplied by the operator.
OPENWEBUI_BASE_URL=https://inside.omirussia.ru
OPENWEBUI_API_KEY=
MODEL=qwen3.8-27b
# Collector and worker safety limits for a local/test run
MAX_PER_SOURCE=10
WORKER_BATCH_SIZE=20
MAX_TEXT_CHARS=12000
MAX_OUTPUT_TOKENS=10000
MAX_FINDINGS_PER_MATERIAL=20
QUALITY_TOTAL_ITEMS=0
# Bump PROMPT_VERSION when extraction rules change. Set REPROCESS_OLD=1 only
# for a controlled pass over materials processed by an older prompt.
PROMPT_VERSION=audience-human-shares-v5
REPROCESS_OLD=0
# Optional comma-separated material ids for a controlled reprocessing sample.
# Keep empty for normal work. When REPROCESS_OLD=1 and this is empty, all old
# materials are eligible for reprocessing.
REPROCESS_MATERIAL_IDS=
# Bot token from @BotFather, only for the bot block
TELEGRAM_TOKEN=
# Public HTTPS address of the Telegram Mini App (optional locally)
MINI_APP_URL=
